# Copy to deploy/.env and fill in. Never commit deploy/.env.
RAG_ENV=prod

# Use only letters and digits in the password (it is embedded in a URL).
POSTGRES_USER=rag
POSTGRES_PASSWORD=changeMeLettersAndDigits1
POSTGRES_DB=rag

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
RAG_JWT_SECRET=

# OpenAI key for embeddings and figure descriptions
RAG_OPENAI_API_KEY=

# Encrypts API keys saved in admin Settings (Fernet). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes saved keys unreadable (Settings shows this; save them again).
RAG_SECRETS_KEY=

# Phoenix tracing UI: http://127.0.0.1:6006 (traces of every question)

# Guardrails (moderation, strikes, cost caps, PII patterns) are configured per RagConfig
# version: GET/POST /api/admin/rag-configs (super_admin). Moderation uses RAG_OPENAI_API_KEY.
